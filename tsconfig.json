{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "paths": {
      "@spartan-ng/helm/alert": [
        "./libs/ui/ui-alert-helm/src/index.ts"
      ],
      "@spartan-ng/helm/avatar": [
        "./libs/ui/ui-avatar-helm/src/index.ts"
      ],
      "@spartan-ng/helm/badge": [
        "./libs/ui/ui-badge-helm/src/index.ts"
      ],
      "@spartan-ng/helm/button": [
        "./libs/ui/ui-button-helm/src/index.ts"
      ],
      "@spartan-ng/helm/card": [
        "./libs/ui/ui-card-helm/src/index.ts"
      ],
      "@spartan-ng/helm/form-field": [
        "./libs/ui/ui-form-field-helm/src/index.ts"
      ],
      "@spartan-ng/helm/icon": [
        "./libs/ui/ui-icon-helm/src/index.ts"
      ],
      "@spartan-ng/helm/input": [
        "./libs/ui/ui-input-helm/src/index.ts"
      ],
      "@spartan-ng/helm/input-otp": [
        "./libs/ui/ui-input-otp-helm/src/index.ts"
      ],
      "@spartan-ng/helm/label": [
        "./libs/ui/ui-label-helm/src/index.ts"
      ],
      "@spartan-ng/helm/menu": [
        "./libs/ui/ui-menu-helm/src/index.ts"
      ],
      "@spartan-ng/helm/progress": [
        "./libs/ui/ui-progress-helm/src/index.ts"
      ],
      "@spartan-ng/helm/scroll-area": [
        "./libs/ui/ui-scroll-area-helm/src/index.ts"
      ],
      "@spartan-ng/helm/separator": [
        "./libs/ui/ui-separator-helm/src/index.ts"
      ],
      "@spartan-ng/helm/skeleton": [
        "./libs/ui/ui-skeleton-helm/src/index.ts"
      ],
      "@spartan-ng/helm/sonner": [
        "./libs/ui/ui-sonner-helm/src/index.ts"
      ],
      "@spartan-ng/helm/spinner": [
        "./libs/ui/ui-spinner-helm/src/index.ts"
      ],
      "@spartan-ng/helm/tabs": [
        "./libs/ui/ui-tabs-helm/src/index.ts"
      ],
      "@spartan-ng/helm/utils": [
        "./libs/ui/ui-utils-helm/src/index.ts"
      ],
      "@spartan-ng/helm/sheet": [
        "./libs/ui/ui-sheet-helm/src/index.ts"
      ],
      "@spartan-ng/helm/tooltip": [
        "./libs/ui/ui-tooltip-helm/src/index.ts"
      ],
      "@spartan-ng/helm/textarea": [
        "./libs/ui/ui-textarea-helm/src/index.ts"
      ],
      "@spartan-ng/helm/item": [
        "./libs/ui/ui-item-helm/src/index.ts"
      ],
      "@spartan-ng/helm/collapsible": [
        "./libs/ui/collapsible/src/index.ts"
      ],
      "@spartan-ng/helm/dropdown-menu": [
        "./libs/ui/dropdown-menu/src/index.ts"
      ],
      "@spartan-ng/helm/sidebar": [
        "./libs/ui/sidebar/src/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
